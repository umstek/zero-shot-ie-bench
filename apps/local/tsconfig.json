{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // the client bundle (src/ui/app.tsx) needs DOM; the server side simply
    // ignores the extra globals
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types.d.ts"]
}
