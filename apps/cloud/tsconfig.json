{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // JSX + DOM for the SPA. "bun" is kept (base sets it) so vite.config.ts gets
    // the node:fs / node:path declarations it needs — bun-types ships them.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],
    "useDefineForClassFields": true
  },
  "include": ["src", "vite.config.ts"]
}
