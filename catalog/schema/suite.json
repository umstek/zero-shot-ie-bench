{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scorer": {
      "type": "string",
      "minLength": 1
    },
    "items_license": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "track",
    "languages",
    "scorer",
    "items_license"
  ],
  "additionalProperties": {}
}
