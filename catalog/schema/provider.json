{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "auth": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "docs": {
      "type": [
        "string",
        "null"
      ]
    },
    "zdr": {
      "type": [
        "string",
        "null"
      ]
    },
    "contracts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "default": "systemone",
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": {}
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "base_url",
    "auth",
    "docs",
    "zdr",
    "contracts"
  ],
  "additionalProperties": {}
}
