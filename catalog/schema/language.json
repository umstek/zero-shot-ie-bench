{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string"
      },
      "script": {
        "type": [
          "string",
          "null"
        ]
      },
      "tier": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "popular",
              "medium",
              "rare"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "code",
      "name",
      "script",
      "tier"
    ],
    "additionalProperties": {}
  }
}
